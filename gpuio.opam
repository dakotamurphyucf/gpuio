opam-version: "2.0"
synopsis: "Native OCaml UI foundation for GPUI and Bonsai"
maintainer: "Dakota Murphy"
authors: "GPUIO contributors"
license: "Apache-2.0"
homepage: "https://github.com/dakotamurphyucf/gpuio"
bug-reports: "https://github.com/dakotamurphyucf/gpuio/issues"
dev-repo: "git+https://github.com/dakotamurphyucf/gpuio.git"
depends: [
  "ocaml" {= "5.3.0"}
  "dune" {= "3.24.2"}
  "core" {= "v0.17.1"}
  "eio" {= "1.3"}
  "eio_main" {= "1.3"}
  "ppx_jane" {= "v0.17.0"}
  "ppx_expect" {= "v0.17.2"}
  "expect_test_helpers_core" {= "v0.17.0"}
  "ocamlformat" {= "0.28.1" & with-dev-setup}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
