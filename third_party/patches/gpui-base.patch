+                // Forget the whole unrecordable transaction and keep collecting
+                // no history until its original bracket closes.
+                pending.bridge_discarded = true;
+                pending.changes = Vec::new();
+                pending.selections_before = None;
+                pending.selections_after = None;
+                pending.auto_closed_pairs_before = None;
+                pending.auto_closed_pairs_after = None;
