+    pub(super) fn bridge_bytes(&self) -> usize {
+        fn cost(
+            changes: &[Change],
+            before: &Option<Vec<CursorSelection>>,
+            after: &Option<Vec<CursorSelection>>,
+        ) -> usize {
+            changes
+                .iter()
+                .map(|change| {
+                    std::mem::size_of::<Change>()
+                        + change.old_text.capacity()
+                        + change.new_text.capacity()
+                })
+                .sum::<usize>()
+                + before
+                    .as_ref()
+                    .map_or(0, |items| std::mem::size_of_val(items.as_slice()))
+                + after
+                    .as_ref()
+                    .map_or(0, |items| std::mem::size_of_val(items.as_slice()))
+        }
+        self.undo_transactions
+            .iter()
+            .chain(&self.redo_transactions)
+            .map(|transaction| {
+                cost(
+                    &transaction.changes,
+                    &transaction.selections_before,
+                    &transaction.selections_after,
+                )
+            })
+            .sum::<usize>()
+            + self.pending.as_ref().map_or(0, |pending| {
+                cost(
+                    &pending.changes,
+                    &pending.selections_before,
+                    &pending.selections_after,
+                )
+            })
+    }
