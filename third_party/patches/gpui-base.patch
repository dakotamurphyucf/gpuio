+    fn enforce_bridge_budget(&mut self) {
+        let Some(limit) = self.bridge_budget else {
+            return;
+        };
+        while self.bridge_bytes() > limit {
+            if !self.undo_transactions.is_empty() {
+                self.undo_transactions.remove(0);
+            } else if !self.redo_transactions.is_empty() {
