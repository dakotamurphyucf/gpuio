+    #[gpui::test]
+    fn test_gpuio_graphemes_across_rope_chunks(cx: &mut TestAppContext) {
+        let view = InputView::build_textarea(cx, |state| state.bridge_max_bytes(262144));
+        let mut cx = VisualTestContext::from_window(view.window_handle.into(), cx);
+        cx.update(|window, cx| {
+            view.input.update(cx, |state, cx| {
+                // Long combining and regional-indicator runs force context
+                // requests across several rope chunks in both directions.
+                let texts = [
+                    String::new(),
+                    "Aé👨‍👩‍👧‍👦e\u{301}👍🏽\r\n🇺🇸Z".repeat(100),
+                    format!("{}e{}Z", "a".repeat(2000), "\u{301}".repeat(2000)),
+                    format!("{}Z", "🇺".repeat(1001)),
+                ];
+                for text in texts {
+                    state.set_value(text.clone(), window, cx);
+                    if text.len() > 2000 {
+                        assert!(state.text.chunks().count() > 1);
+                    }
+                    let mut boundaries = text
+                        .grapheme_indices(true)
+                        .map(|(offset, _)| offset)
+                        .collect::<Vec<_>>();
+                    boundaries.push(text.len());
+                    assert_eq!(state.previous_boundary(0), 0);
+                    assert_eq!(state.next_boundary(text.len()), text.len());
+                    for pair in boundaries.windows(2) {
+                        assert_eq!(state.next_boundary(pair[0]), pair[1]);
+                        assert_eq!(state.previous_boundary(pair[1]), pair[0]);
+                    }
+                }
+            })
+        });
+    }
