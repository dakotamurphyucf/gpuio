+    /// GPUIO's ordinary inputs navigate extended graphemes, including clusters
+    /// spanning rope chunks. Avoid copying/scanning the full document per key.
+    fn bridge_grapheme_boundary(&self, offset: usize, forward: bool) -> usize {
+        let len = self.text.len();
+        let offset = offset.min(len);
+        let mut cursor = GraphemeCursor::new(offset, len, true);
+        let (mut chunk, mut start) = self.text.chunk(offset);
+        loop {
+            let result = if forward {
+                cursor.next_boundary(chunk, start)
+            } else {
+                cursor.prev_boundary(chunk, start)
+            };
+            match result {
+                Ok(Some(offset)) => return offset,
+                Ok(None) => return if forward { len } else { 0 },
+                Err(GraphemeIncomplete::PreContext(end)) => {
+                    let (context, context_start) = self.text.chunk(end - 1);
+                    cursor.provide_context(&context[..end - context_start], context_start);
+                }
+                Err(GraphemeIncomplete::NextChunk) => {
+                    (chunk, start) = self.text.chunk(start + chunk.len());
+                }
+                Err(GraphemeIncomplete::PrevChunk) => {
+                    (chunk, start) = self.text.chunk(start - 1);
+                }
+                Err(GraphemeIncomplete::InvalidOffset) => unreachable!("validated rope offset"),
+            }
+        }
     }
 
